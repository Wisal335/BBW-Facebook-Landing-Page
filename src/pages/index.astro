---
import "../styles/style.css";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Local Trust & Proof | Free Local Visibility & Search Audit | Big Brain Way"
    description="Turn local reviews, search visibility and community trust into a stronger pipeline. Book a free Local Visibility & Search Audit with Big Brain Way."
>

<!-- =========================================================
     SCROLL PROGRESS
========================================================= -->

<div
    class="scroll-progress"
    id="scrollProgress"
    aria-hidden="true"
></div>


<!-- =========================================================
     PAGE BACKGROUND
========================================================= -->

<div
    class="page-background"
    aria-hidden="true"
>

    <div class="background-orb orb-one"></div>
    <div class="background-orb orb-two"></div>
    <div class="background-grid"></div>

</div>


<!-- =========================================================
     HEADER
========================================================= -->

<header class="site-header">

    <div class="header-inner">

        <a
            href="#top"
            class="brand"
            aria-label="Big Brain Way home"
        >

            <img
                src="/image/BBW%20Logo.png"
                alt="Big Brain Way"
                class="brand-logo"
            />

        </a>


        <div class="header-right">

            <span class="header-status">

                <span
                    class="status-dot"
                    aria-hidden="true"
                ></span>

                Local Trust & Proof

            </span>


            <a
                href="#booking"
                class="header-cta"
            >
                Get Free Audit
            </a>

        </div>

    </div>

</header>


<!-- =========================================================
     MAIN
========================================================= -->

<main id="top">


<!-- =========================================================
     HERO
========================================================= -->

<section
    class="hero-section"
    aria-labelledby="hero-title"
>

    <div class="hero-container">


        <!-- LEFT COLUMN -->

        <div class="hero-copy reveal">

            <div class="eyebrow">

                <span class="eyebrow-line"></span>

                <span>
                    FACEBOOK • LOCAL TRUST & PROOF
                </span>

            </div>


            <h1 id="hero-title">

                Turn Your Local Reputation Into

                <span class="gradient-text">
                    &nbsp; More Calls.
                </span>

            </h1>


            <p class="hero-description">

                Great service is not enough if AI search does not
                recommend you. Customers increasingly ask search
                engines and AI assistants which local business to choose.

                <strong>
                    &nbsp; Our Local Trust & Proof approach shows where
                    your visibility is leaking and what to strengthen first.
                </strong>

            </p>


            <!-- VALUE SIGNALS -->
            <div class="hero-signals">
                <div class="signal-item"><span class="signal-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5l2.6 5.25 5.9.86-4.25 4.14 1 5.85L12 16.85 6.75 19.6l1-5.85L3.5 9.61l5.9-.86L12 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><div><strong>Reputation Signals</strong><span>Build customer proof</span></div></div>
                <div class="signal-item"><span class="signal-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5M8.5 11h5M11 8.5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><div><strong>AI & Local Search</strong><span>Strengthen discovery</span></div></div>
                <div class="signal-item"><span class="signal-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.8"/></svg></span><div><strong>Local Trust</strong><span>Turn visibility into action</span></div></div>
            </div>


            <!-- PRIMARY CTA -->

            <div class="hero-actions">

                <a
                    href="#booking"
                    class="primary-button"
                >

                    <span>
                        Get My Free Local Visibility Audit
                    </span>

                    <span
                        class="button-arrow"
                        aria-hidden="true"
                    >
                        →
                    </span>

                </a>


                <span class="cta-note">
                    Free • No obligation • Built for local service businesses
                </span>

            </div>


            <!-- DATA FRAME -->

            <div class="hero-data-frame">

                <div class="data-frame-heading">

                    <span class="live-pulse"></span>

                    LOCAL VISIBILITY SIGNALS

                </div>


                <div class="data-frame-grid">

                    <div class="data-point">

                        <strong data-counter="3">
                            3
                        </strong>

                        <span>
                            Search positions
                        </span>

                    </div>


                    <div class="data-point">

                        <strong>
                            ★★★★★
                        </strong>

                        <span>
                            Trust signal
                        </span>

                    </div>


                    <div class="data-point">

                        <strong data-counter="24">
                            24/7
                        </strong>

                        <span>
                            Customer discovery
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT COLUMN -->

        <div class="hero-visual reveal">

            <div class="visual-glow"></div>


            <div class="search-interface">


                <!-- SEARCH HEADER -->

                <div class="search-interface-top">

                    <div class="browser-dots">

                        <span></span>
                        <span></span>
                        <span></span>

                    </div>


                    <div class="search-pill">

                        <span class="search-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                        <span id="locationQuery">best med spa near me</span>

                    </div>


                    <span class="preview-label">
                        PREVIEW
                    </span>

                </div>


                <!-- LOCAL MAP -->

                <div class="map-area">

                    <div class="map-label">
                        ILLUSTRATIVE LOCAL SEARCH VIEW
                    </div>


                    <div class="map-grid"></div>

                    <div class="map-road road-one"></div>
                    <div class="map-road road-two"></div>
                    <div class="map-road road-three"></div>

                    <div class="map-water"></div>


                    <div class="map-pin pin-one">
                        <span>1</span>
                    </div>

                    <div class="map-pin pin-two">
                        <span>2</span>
                    </div>

                    <div class="map-pin pin-three">
                        <span>3</span>
                    </div>


                    <div class="map-location">

                        <span class="location-pulse"></span>

                    </div>

                </div>


                <!-- LOCAL 3-PACK -->

                <div class="pack-panel" id="localSearchPack">

                    <div class="pack-heading">

                        <div>

                            <span class="mini-eyebrow">
                                LOCAL 3-PACK
                            </span>

                            <strong>
                                Reputation + Visibility
                            </strong>

                        </div>


                        <span class="pack-status">
                            LIVE SIGNAL
                        </span>

                    </div>


                    <!-- LISTING 1 -->

                    <article class="local-listing active" data-location-listing="0">

                        <div class="listing-rank">
                            1
                        </div>


                        <div class="listing-content">

                            <div class="listing-top">

                                <strong>
                                    Summit Home Services
                                </strong>

                                <span class="verified-mark">
                                    ✓
                                </span>

                            </div>


                            <span class="listing-category">
                                General Contractor
                            </span>


                            <div class="listing-rating">

                                <strong>
                                    4.9
                                </strong>

                                <span class="stars">
                                    ★★★★★
                                </span>

                                <span class="review-count">
                                    187 reviews
                                </span>

                            </div>


                            <span class="listing-meta">
                                Local service • Open
                            </span>

                        </div>


                        <span class="listing-arrow">
                            ↗
                        </span>

                    </article>


                    <!-- LISTING 2 -->

                    <article class="local-listing" data-location-listing="1">

                        <div class="listing-rank">
                            2
                        </div>


                        <div class="listing-content">

                            <div class="listing-top">

                                <strong>
                                    North Ridge Roofing
                                </strong>

                            </div>


                            <span class="listing-category">
                                Roofing Contractor
                            </span>


                            <div class="listing-rating">

                                <strong>
                                    4.8
                                </strong>

                                <span class="stars">
                                    ★★★★★
                                </span>

                                <span class="review-count">
                                    143 reviews
                                </span>

                            </div>


                            <span class="listing-meta">
                                Local service • Open
                            </span>

                        </div>


                        <span class="listing-arrow">
                            ↗
                        </span>

                    </article>


                    <!-- LISTING 3 -->

                    <article class="local-listing" data-location-listing="2">

                        <div class="listing-rank">
                            3
                        </div>


                        <div class="listing-content">

                            <div class="listing-top">

                                <strong>
                                    BluePeak Local Agency
                                </strong>

                            </div>


                            <span class="listing-category">
                                Marketing Agency
                            </span>


                            <div class="listing-rating">

                                <strong>
                                    4.9
                                </strong>

                                <span class="stars">
                                    ★★★★★
                                </span>

                                <span class="review-count">
                                    96 reviews
                                </span>

                            </div>


                            <span class="listing-meta">
                                Local service • Open
                            </span>

                        </div>


                        <span class="listing-arrow">
                            ↗
                        </span>

                    </article>


                    <div class="mockup-disclaimer">
                        Illustrative example - not an actual Google ranking.
                    </div>

                </div>

            </div>


            <!-- FLOATING REPUTATION CARD -->

            <div class="floating-proof-card">

                <div class="floating-proof-icon">
                    ★
                </div>

                <div>

                    <span>
                        TRUST SIGNAL
                    </span>

                    <strong>
                        5-Star Reputation
                    </strong>

                </div>

                <div class="floating-proof-bars">

                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     TRUST BRIDGE
========================================================= -->

<section
    class="trust-bridge section"
    aria-labelledby="trust-title"
>

    <div class="section-container">

        <div class="section-heading centered reveal">

            <span class="section-kicker">
                THE LOCAL TRUST GAP
            </span>

            <h2 id="trust-title">

                Great Service Is Not Enough

                <span class="gradient-text">
                    &nbsp;If Nobody Sees It.
                </span>

            </h2>

            <p>
                Customers compare businesses before they call.
                Your reviews, local visibility, consistency and
                proof all contribute to the decision.
            </p>

        </div>


        <div class="trust-grid">
            <article class="problem-card reveal" tabindex="0" role="button" aria-expanded="false"><div class="problem-card-inner"><div class="problem-card-face problem-card-front"><span class="problem-number">01</span><div class="problem-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 18.5V8.5l8-4 8 4v10" stroke="currentColor" stroke-width="1.8"/><path d="M8 18.5v-6h8v6M6 20h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></div><h3>Invisible</h3><p>AI and local search may not surface your business when nearby customers ask for what you offer.</p><span class="problem-tag">VISIBILITY</span><span class="card-action">Hover or tap to see the signal</span></div><div class="problem-card-face problem-card-back"><span class="problem-number">01</span><h3>What to strengthen</h3><p>Business profile completeness, local relevance, category signals, service coverage and clear location information.</p><span class="problem-tag">LOCAL SIGNALS</span></div></div></article>
            <article class="problem-card reveal" tabindex="0" role="button" aria-expanded="false"><div class="problem-card-inner"><div class="problem-card-face problem-card-front"><span class="problem-number">02</span><div class="problem-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" stroke="currentColor" stroke-width="1.8"/></svg></div><h3>Unconvincing</h3><p>Customers compare options quickly. Weak or outdated proof can make another local business easier to trust.</p><span class="problem-tag">REPUTATION</span><span class="card-action">Hover or tap to see the signal</span></div><div class="problem-card-face problem-card-back"><span class="problem-number">02</span><h3>What to strengthen</h3><p>Review quality, recency, volume, response signals and proof that reflects the customer experience.</p><span class="problem-tag">LOCAL SIGNALS</span></div></div></article>
            <article class="problem-card reveal" tabindex="0" role="button" aria-expanded="false"><div class="problem-card-inner"><div class="problem-card-face problem-card-front"><span class="problem-number">03</span><div class="problem-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h10M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="18" cy="12" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg></div><h3>Inconsistent</h3><p>Conflicting business information creates friction between discovery, trust and the next customer action.</p><span class="problem-tag">CONSISTENCY</span><span class="card-action">Hover or tap to see the signal</span></div><div class="problem-card-face problem-card-back"><span class="problem-number">03</span><h3>What to strengthen</h3><p>Business name, address, phone, service details and location signals should tell the same story everywhere.</p><span class="problem-tag">LOCAL SIGNALS</span></div></div></article>
        </div>

    </div>

</section>


<!-- =========================================================
     LIVING BLUEPRINT
========================================================= -->

<section
    class="blueprint-section section"
    aria-labelledby="blueprint-title"
>

    <div class="section-container">

        <div class="blueprint-header reveal">

            <div class="section-heading">

                <span class="section-kicker">
                    LOCAL TRUST & PROOF BLUEPRINT
                </span>

                <h2 id="blueprint-title">

                    Build The Signals

                    <span class="gradient-text">
                        &nbsp; Customers Actually Use.
                    </span>

                </h2>

                <p>
                    We focus on the signals customers and AI systems actually
                    use: discoverability, reputation, consistency and
                    a clear path to contact.
                </p>

            </div>


            <div class="blueprint-status">

                <span class="live-pulse"></span>

                EXPERIENCE MAP

            </div>

        </div>


        <div class="blueprint">

            <div class="blueprint-line"></div>


            <!-- STEP 1 -->

            <article class="blueprint-step reveal">

                <div class="step-marker">
                    <span>01</span>
                </div>


                <div class="step-content">

                    <span class="step-kicker">
                        DISCOVER
                    </span>

                    <h3 class="blueprint-question">Can nearby customers find you?</h3>

                    <p>
                        We inspect the local search signals that
                        influence how your business appears when
                        customers are actively looking for a service.
                    </p>


                    <div class="step-metrics">

                        <span>
                            Local visibility
                        </span>

                        <span>
                            Search presence
                        </span>

                        <span>
                            Business profile
                        </span>

                    </div>

                </div>


                <div class="step-visual discover-visual">

                    <div class="radar">

                        <div class="radar-ring ring-one"></div>
                        <div class="radar-ring ring-two"></div>
                        <div class="radar-ring ring-three"></div>

                        <div class="radar-sweep"></div>

                        <span class="radar-dot dot-a"></span>
                        <span class="radar-dot dot-b"></span>
                        <span class="radar-dot dot-c"></span>

                        <span class="radar-center"></span>

                    </div>

                </div>

            </article>


            <!-- STEP 2 -->

            <article class="blueprint-step reverse reveal">

                <div class="step-marker">
                    <span>02</span>
                </div>


                <div class="step-content">

                    <span class="step-kicker">
                        STRENGTHEN
                    </span>

                    <h3 class="blueprint-question">Does your reputation support the click?</h3>

                    <p>
                        Reviews are not simply a number. Recency,
                        volume, response quality and consistency all
                        contribute to the proof customers encounter.
                    </p>


                    <div class="step-metrics">

                        <span>
                            Review quality
                        </span>

                        <span>
                            Review velocity
                        </span>

                        <span>
                            Response signals
                        </span>

                    </div>

                </div>


                <div class="step-visual reputation-visual">

                    <div class="rating-orbit">

                        <div class="orbit-ring"></div>

                        <div class="orbit-stars">
                            ★★★★★
                        </div>

                        <span class="orbit-dot orbit-dot-one"></span>
                        <span class="orbit-dot orbit-dot-two"></span>

                        <strong>
                            TRUST
                        </strong>

                    </div>

                </div>

            </article>


            <!-- STEP 3 -->

            <article class="blueprint-step reveal">

                <div class="step-marker">
                    <span>03</span>
                </div>


                <div class="step-content">

                    <span class="step-kicker">
                        CONVERT
                    </span>

                    <h3 class="blueprint-question">Does the proof make choosing you easier?</h3>

                    <p>
                        The final step connects visibility and
                        reputation to a clear customer action:
                        calling, contacting or requesting your service.
                    </p>


                    <div class="step-metrics">

                        <span>
                            Trust architecture
                        </span>

                        <span>
                            Clear action
                        </span>

                        <span>
                            Conversion path
                        </span>

                    </div>

                </div>


                <div class="step-visual convert-visual">

                    <div class="conversion-flow">

                        <div class="flow-node">
                            FIND
                        </div>

                        <span class="flow-arrow">
                            →
                        </span>

                        <div class="flow-node">
                            TRUST
                        </div>

                        <span class="flow-arrow">
                            →
                        </span>

                        <div class="flow-node active">
                            CALL
                        </div>

                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     SOCIAL PROOF
========================================================= -->

<section
    class="proof-section section"
    aria-labelledby="proof-title"
>

    <div class="section-container">

        <div class="section-heading centered reveal">

            <span class="section-kicker">
                SOCIAL PROOF
            </span>

            <h2 id="proof-title">

                Make Your Reputation

                <span class="gradient-text">
                    Visible.
                </span>

            </h2>

            <p>
                Your strongest proof should not be hidden inside
                a review platform. It should become part of the
                story customers see.
            </p>

        </div>


        <div class="testimonial-slider" id="testimonialSlider" aria-live="polite"><div class="testimonial-track">
            <article class="testimonial-slide is-active"><div class="testimonial-card featured"><div class="testimonial-top"><div class="testimonial-stars">★★★★★</div><span class="proof-label">DIANA REVIEW - PENDING APPROVAL</span></div><blockquote>Approved Diana customer review text should be inserted after coordination with Eman. The supplied meeting notes identify Diana as the AI-search discovery testimonial, but do not contain the approved wording.</blockquote><div class="testimonial-author"><div class="author-avatar">D</div><div><strong>Diana</strong><span>AI-search discovery story</span></div></div></div></article>
            <article class="testimonial-slide"><div class="testimonial-card"><div class="testimonial-top"><div class="testimonial-stars">★★★★★</div><span class="proof-label">CLIENT STORY SLOT</span></div><blockquote>Insert an approved customer review here before publishing. Illustrative copy should not be presented as a testimonial.</blockquote><div class="testimonial-author"><div class="author-avatar">C</div><div><strong>Client testimonial</strong><span>Awaiting approved source text</span></div></div></div></article>
            <article class="testimonial-slide"><div class="testimonial-card"><div class="testimonial-top"><div class="testimonial-stars">★★★★★</div><span class="proof-label">CLIENT STORY SLOT</span></div><blockquote>Insert another approved customer review here before publishing, tied to a real customer experience.</blockquote><div class="testimonial-author"><div class="author-avatar">C</div><div><strong>Client testimonial</strong><span>Awaiting approved source text</span></div></div></div></article>
        </div><div class="testimonial-controls"><button type="button" class="testimonial-prev" aria-label="Previous testimonial">←</button><div class="testimonial-dots" role="tablist" aria-label="Testimonials"><button type="button" class="is-active" aria-label="Testimonial 1" aria-selected="true"></button><button type="button" aria-label="Testimonial 2" aria-selected="false"></button><button type="button" aria-label="Testimonial 3" aria-selected="false"></button></div><button type="button" class="testimonial-next" aria-label="Next testimonial">→</button></div></div>
        <p class="proof-editor-note reveal"><span>Content note:</span> The Scrum notes require real customer testimonials and an approved Diana AI-search review. The actual approved quote was not included in the supplied project or notes, so it has not been invented.</p>
    </div>

</section>


<!-- =========================================================
     BOOKING / FORM
========================================================= -->

<section
    class="booking-section section"
    id="booking"
    aria-labelledby="booking-title"
>

    <div class="booking-container">


        <!-- AUDIT + CONTACT, CONSOLIDATED -->
        <div class="booking-intro reveal"><span class="section-kicker">FREE LOCAL VISIBILITY & SEARCH AUDIT</span><h2 id="booking-title">See What Customers See <span class="gradient-text">Before They Choose.</span></h2><p>One streamlined audit and contact step. We look at local search presence, reputation signals, consistency and the path from discovery to action.</p><div class="audit-checklist compact-audit-checklist"><div class="audit-check"><span>✓</span><div><strong>Local Search Presence</strong><p>Where your business appears for high-intent local searches.</p></div></div><div class="audit-check"><span>✓</span><div><strong>Reputation Signals</strong><p>Review quality, recency, volume and response patterns.</p></div></div><div class="audit-check"><span>✓</span><div><strong>Trust & Conversion</strong><p>Whether your proof makes the next action clear.</p></div></div><div class="audit-check"><span>✓</span><div><strong>Competitive Context</strong><p>What nearby customers encounter when comparing options.</p></div></div></div><div class="audit-dashboard compact-audit-dashboard"><div class="dashboard-header"><div><span>AUDIT SIGNAL FRAME</span><strong>Local Trust Snapshot</strong></div><span class="dashboard-live">● READY</span></div><div class="dashboard-score"><div class="score-ring"><div class="score-ring-inner"><strong>?</strong><span>SCORE</span></div></div><div class="score-copy"><span>Your current local trust picture</span><strong>Start with the data.</strong><p>The audit turns scattered signals into a practical priority map.</p></div></div><div class="dashboard-footer"><span>Illustrative frame</span><span>● Audit ready</span></div></div></div>


        <!-- CUSTOM ON-PAGE FORM -->

        <div class="booking-card reveal">

            <div class="booking-card-header">

                <div>

                    <span class="booking-badge">
                        FREE AUDIT
                    </span>

                    <h3>
                        Tell Us Where To Look
                    </h3>

                </div>


                <div class="booking-lock">
                    <span>● </span>
                    Private request
                </div>

            </div>


            <!-- =================================================
                 FACEBOOK FORM
                 Submission goes to Facebook Apps Script only.
            ================================================== -->

            <form
                id="auditForm"
                name="Local-Visibility-Audit"
            >

                <div class="form-grid">


                    <!-- FIRST NAME -->

                    <div class="form-field">

                        <label for="firstName">
                            First name
                            <span>*</span>
                        </label>

                        <input
                            type="text"
                            id="firstName"
                            name="firstName"
                            placeholder="Your first name"
                            autocomplete="given-name"
                            required
                        />

                    </div>


                    <!-- LAST NAME -->

                    <div class="form-field">

                        <label for="lastName">
                            Last name
                            <span>*</span>
                        </label>

                        <input
                            type="text"
                            id="lastName"
                            name="lastName"
                            placeholder="Your last name"
                            autocomplete="family-name"
                            required
                        />

                    </div>


                    <!-- BUSINESS -->

                    <div class="form-field full">

                        <label for="business">
                            Business name
                            <span>*</span>
                        </label>

                        <input
                            type="text"
                            id="business"
                            name="business"
                            placeholder="Your business name"
                            autocomplete="organization"
                            required
                        />

                    </div>


                    <!-- EMAIL -->

                    <div class="form-field">

                        <label for="email">
                            Email
                            <span>*</span>
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@business.com"
                            autocomplete="email"
                            required
                        />

                    </div>


                    <!-- PHONE -->

                    <div class="form-field">

                        <label for="phone">
                            Phone
                            <span>*</span>
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="+1 000 000 0000"
                            autocomplete="tel"
                            required
                        />

                    </div>


                    <!-- WEBSITE -->

                    <div class="form-field full">

                        <label for="website">
                            Website or Business Profile URL
                        </label>

                        <input
                            type="url"
                            id="website"
                            name="website"
                            placeholder="https://yourbusiness.com"
                            autocomplete="url"
                        />

                    </div>


                    <!-- SERVICE -->

                    <div class="form-field">

                        <label for="service">
                            Primary service
                            <span>*</span>
                        </label>

                        <select
                            id="service"
                            name="service"
                            required
                        >

                            <option value="">
                                Select one
                            </option>

                            <option value="contractor">
                                Contractor
                            </option>

                            <option value="home-services">
                                Home Services
                            </option>

                            <option value="roofing">
                                Roofing
                            </option>

                            <option value="agency">
                                Local Agency
                            </option>

                            <option value="professional-services">
                                Professional Services
                            </option>

                            <option value="other">
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- SERVICE AREA -->

                    <div class="form-field">

                        <label for="serviceArea">
                            Main service area
                            <span>*</span>
                        </label>

                        <input
                            type="text"
                            id="serviceArea"
                            name="serviceArea"
                            placeholder="City / Region"
                            required
                        />

                    </div>


                    <!-- DATE -->

                    <div class="form-field">

                        <label for="preferredDate">
                            Preferred date
                            <span>*</span>
                        </label>

                        <input
                            type="date"
                            id="preferredDate"
                            name="preferredDate"
                            required
                        />

                    </div>


                    <!-- TIME -->

                    <div class="form-field">

                        <label for="preferredTime">
                            Preferred time
                            <span>*</span>
                        </label>

                        <select
                            id="preferredTime"
                            name="preferredTime"
                            required
                        >

                            <option value="">
                                Select a time
                            </option>

                            <option value="morning">
                                Morning
                            </option>

                            <option value="midday">
                                Midday
                            </option>

                            <option value="afternoon">
                                Afternoon
                            </option>

                            <option value="evening">
                                Evening
                            </option>

                        </select>

                    </div>


                </div>


                <!-- CONSENT -->

                <label class="consent-row">

                    <input
                        type="checkbox"
                        id="consent"
                        name="consent"
                        value="yes"
                        required
                    />

                    <span class="custom-checkbox"></span>

                    <span>
                        I agree to be contacted about my audit request.
                    </span>

                </label>


                <!-- ERROR -->

                <div
                    class="form-error"
                    id="formError"
                    role="alert"
                    aria-live="polite"
                ></div>


                <!-- SUBMIT -->

                <button
                    type="submit"
                    class="form-submit"
                    id="formSubmit"
                >

                    <span class="submit-text">
                        Request My Free Audit
                    </span>

                    <span
                        class="submit-arrow"
                        aria-hidden="true"
                    >
                        →
                    </span>

                </button>


                <p class="form-disclaimer">

                    Your details are used only to respond to this
                    audit request.

                </p>

            </form>


            <!-- =================================================
                 SUCCESS STATE
            ================================================== -->

            <div
                class="form-success"
                id="formSuccess"
                aria-live="polite"
                hidden
            >

                <div class="success-icon">
                    ✓
                </div>

                <span class="success-kicker">
                    REQUEST RECEIVED
                </span>

                <h3>
                    Thanks, <span id="successName">there</span>.
                </h3>

                <p>
                    Your free Local Visibility &amp; Search Audit request
                    has been received. Our team will review your details
                    and follow up using the contact information you provided.
                </p>

                <button
                    type="button"
                    class="success-reset"
                    id="successReset"
                >
                    Submit another request
                </button>

            </div>

        </div>

    </div>

</section>


